{
 "surah": 113,
 "ayahs": [
  {
   "k": "113:1",
   "u": " قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
   "e": "Say, \"I seek refuge in the Lord of daybreak",
   "t": "Qul aAAoothu birabbi alfalaq"
  },
  {
   "k": "113:2",
   "u": "مِن شَرِّ مَا خَلَقَ",
   "e": "From the evil of that which He created",
   "t": "Min sharri ma khalaq"
  },
  {
   "k": "113:3",
   "u": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
   "e": "And from the evil of darkness when it settles",
   "t": "Wamin sharri ghasiqin ithawaqab"
  },
  {
   "k": "113:4",
   "u": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
   "e": "And from the evil of the blowers in knots",
   "t": "Wamin sharri annaffathatifee alAAuqad"
  },
  {
   "k": "113:5",
   "u": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
   "e": "And from the evil of an envier when he envies.\"",
   "t": "Wamin sharri hasidin itha hasad"
  }
 ]
}