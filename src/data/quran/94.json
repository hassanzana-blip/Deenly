 "ayahs": [
  {
   "k": "94:1",
   "u": " أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
   "e": "Did We not expand for you, [O Muḥammad], your breast?1",
   "t": "Alam nashrah laka sadrak"
  },
  {
   "k": "94:2",
   "u": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
   "e": "And We removed from you your burden",
   "t": "WawadaAAna AAanka wizrak"
  },
  {
   "k": "94:3",
   "u": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
   "e": "Which had weighed upon your back",
   "t": "Allathee anqada thahrak"
  },
  {
   "k": "94:4",
   "u": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
   "e": "And raised high for you your repute.",
   "t": "WarafaAAna laka thikrak"
  },
  {
   "k": "94:5",
   "u": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
   "e": "For indeed, with hardship [will be] ease [i.e., relief].",
   "t": "Fa-inna maAAa alAAusri yusra"
  },
  {
   "k": "94:6",
   "u": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
   "e": "Indeed, with hardship [will be] ease.",
   "t": "Inna maAAa alAAusri yusra"
  },
  {
   "k": "94:7",
   "u": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
   "e": "So when you have finished [your duties], then stand up [for worship].",
   "t": "Fa-itha faraghta fansab"
  },
  {
   "k": "94:8",
   "u": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
   "e": "And to your Lord direct [your] longing.",
   "t": "Wa-ila rabbika farghab"
  }
 ]
