{
 "surah": 112,
 "ayahs": [
  {
   "k": "112:1",
   "u": " قُلْ هُوَ ٱللَّهُ أَحَدٌ",
   "e": "Say, \"He is Allāh, [who is] One,",
   "t": "Qul huwa Allahu ahad"
  },
  {
   "k": "112:2",
   "u": "ٱللَّهُ ٱلصَّمَدُ",
   "e": "Allāh, the Eternal Refuge.",
   "t": "Allahu assamad"
  },
  {
   "k": "112:3",
   "u": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
   "e": "He neither begets nor is born,",
   "t": "Lam yalid walam yoolad"
  },
  {
   "k": "112:4",
   "u": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
   "e": "Nor is there to Him any equivalent.\"",
   "t": "Walam yakun lahu kufuwan ahad"
  }
 ]
}