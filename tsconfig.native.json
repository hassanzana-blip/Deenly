{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.native.tsbuildinfo",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["index.ts", "native", "src/dom", "src/lib", "src/data"]
}
