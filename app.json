{
  "expo": {
    "name": "DeenDunya",
    "slug": "deendunya",
    "scheme": "deendunya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf9f7",
    "ios": {
      "bundleIdentifier": "com.hassanzana.deendunya",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "nb",
        "CFBundleLocalizations": [
          "nb",
          "en",
          "ar",
          "ckb"
        ],
        "UIStatusBarHidden": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 110,
          "resizeMode": "contain",
          "backgroundColor": "#2f6cb3"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeenDunya uses your location to calculate accurate prayer times for where you are."
        }
      ],
      "expo-web-browser"
    ]
  }
}
